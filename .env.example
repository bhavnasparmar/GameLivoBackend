# ==============================================================================
# GameLivo Backend — Environment Configuration Example (.env.example)
# ==============================================================================
# Set NODE_ENV to: development | staging | production | test
# All URLs (API, Socket, Client, CORS) and defaults are automatically resolved
# by src/config/env.ts according to the environment chosen here.
# ==============================================================================

# Server Environment & Network
NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# Optional URL overrides (leave commented to use environment preset defaults from src/config/env.ts)
# API_URL=http://localhost:5000/api/v1
# SOCKET_URL=http://localhost:5000
# CLIENT_URL=http://localhost:3000
# CORS_ORIGIN=*

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=gamelivo

# Cache & In-Memory Store (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets & Expiry
JWT_SECRET=your_jwt_secret_key_here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_REFRESH_EXPIRY=7d

# OTP Settings
OTP_EXPIRY_SECONDS=300
OTP_DEV_MOCK=true

# File Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# Logging (debug | info | warn | error)
LOG_LEVEL=info

